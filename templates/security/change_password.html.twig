{% extends 'base.html.twig' %}
{% block title %}Смена пароля{% endblock %}
{% block body %}
<h1>Смена пароля</h1>
{% if forced %}<div class="flash warning">Перед началом работы смените первоначальный пароль.</div>{% endif %}
{% for e in errors %}<div class="flash error">{{ e }}</div>{% endfor %}
<form method="post" class="panel" style="max-width:440px">
    <div class="field"><label>Текущий пароль</label><input type="password" name="current" autocomplete="current-password" required></div>
    <div class="field"><label>Новый пароль</label><input type="password" name="new" autocomplete="new-password" required minlength="{{ min }}">
        <div class="help">Не менее {{ min }} символов: заглавные и строчные буквы, цифра, спецсимвол; без логина.</div></div>
    <div class="field"><label>Повторите новый пароль</label><input type="password" name="repeat" autocomplete="new-password" required></div>
    <input type="hidden" name="_token" value="{{ csrf_token('change_password') }}">
    <button class="btn primary">Сменить пароль</button>
</form>
{% endblock %}
