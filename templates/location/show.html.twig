{% extends 'base.html.twig' %}
{% block title %}{{ loc.name }}{% endblock %}
{% block body %}
<p class="small muted">{% for p in loc.path %}<a href="{{ path('location_show', {id: p.id}) }}">{{ p.name }}</a>{{ not loop.last ? ' / ' }}{% endfor %}</p>
<div class="actions" style="justify-content:space-between">
<h1>{{ loc.name }} <span class="badge gray">{{ loc.type.label }}{% if loc.roomType %} · {{ loc.roomType.label }}{% endif %}</span></h1>
{% if is_granted('ROLE_ADMIN') %}<form method="post" action="{{ path('location_delete', {id: loc.id}) }}" class="inline-form" data-confirm="Удалить локацию «{{ loc.name }}»{{ plans|length ? ' вместе с планами (' ~ plans|length ~ ')' }}?">
    <input type="hidden" name="_token" value="{{ csrf_token('location_delete' ~ loc.id) }}"><button class="btn danger">Удалить локацию</button></form>{% endif %}
</div>
<div class="grid g2">
    <div class="panel">
        <p>Активов (включая вложенные): <b>{{ total }}</b></p>
        {% if children|length %}<p>Вложенные: {% for c in children %}<a href="{{ path('location_show', {id: c.id}) }}">{{ c.name }}</a>{{ not loop.last ? ', ' }}{% endfor %}</p>{% endif %}
        <a class="btn" href="{{ path('asset_index', {location: loc.id}) }}">Открыть в реестре</a>
    </div>
    <div class="panel">
        <h3 style="margin-top:0">Планы</h3>
        {% for p in plans %}<p><a href="{{ path('plan_show', {id: p.id}) }}">{{ p.name }}</a> <span class="small muted">{{ p.mimeType == 'image/svg+xml' ? 'SVG' : 'PNG' }}, областей: {{ p.regions|length }}</span>
            {% if is_granted('ROLE_ADMIN') %}<form method="post" action="{{ path('plan_delete', {id: p.id}) }}" class="inline-form" data-confirm="Удалить план «{{ p.name }}»?">
                <input type="hidden" name="_token" value="{{ csrf_token('plan_delete' ~ p.id) }}"><button class="btn small danger">Удалить</button></form>{% endif %}</p>{% else %}<p class="muted">Нет планов.</p>{% endfor %}
        {% if is_granted('ROLE_IT') %}
        <form method="post" enctype="multipart/form-data" action="{{ path('plan_upload', {id: loc.id}) }}">
            <div class="field"><label>Название плана</label><input type="text" name="name" value="{{ loc.name }}"></div>
            <div class="field"><input type="file" name="file" accept=".svg,.png" required>
                <div class="help">Предпочтительно SVG; PNG — не менее 2000 px по длинной стороне. PDF конвертируйте в SVG заранее, DWG не загружается.</div></div>
            <input type="hidden" name="_token" value="{{ csrf_token('plan_upload' ~ loc.id) }}"><button class="btn">Загрузить план</button>
        </form>
        {% endif %}
    </div>
</div>
<h2>Оборудование</h2>
<div class="table-wrap"><table>
    <thead><tr><th>Инв. номер</th><th>Наименование</th><th>Статус</th><th>Сотрудник</th><th>Помещение</th></tr></thead>
    {% for a in assets %}<tr><td class="mono"><a href="{{ path('asset_show', {id: a.id}) }}">{{ a.inventoryNumber }}</a></td><td>{{ a.name }}</td><td>{{ a.status|status_badge }}</td>
        <td>{{ a.employee ? a.employee.name }}</td><td class="small">{{ a.location ? a.location.name }}</td></tr>
    {% else %}<tr><td colspan="5" class="muted">Нет оборудования</td></tr>{% endfor %}
</table></div>
{% endblock %}
