{% extends 'base.html.twig' %}
{% block title %}Комплект {{ bundle.name }}{% endblock %}
{% block body %}
<h1>Комплект: {{ bundle.name }}</h1>
{% if bundle.comment %}<p class="muted">{{ bundle.comment }}</p>{% endif %}
<form method="post" action="{{ path('bundle_items', {id: bundle.id}) }}" class="panel actions">
    <input type="text" name="code" id="scan" class="mono" placeholder="Сканируйте или введите инв. номер компонента" style="max-width:380px" autofocus>
    <input type="hidden" name="_token" value="{{ csrf_token('bundle' ~ bundle.id) }}"><button class="btn primary">Добавить</button>
</form>
<div class="table-wrap"><table>
    <thead><tr><th>Инв. номер</th><th>Наименование</th><th>Статус</th><th>Сотрудник</th><th>Местоположение</th><th></th></tr></thead>
    {% for a in bundle.assets %}<tr><td class="mono"><a href="{{ path('asset_show', {id: a.id}) }}">{{ a.inventoryNumber }}</a></td><td>{{ a.name }}</td><td>{{ a.status|status_badge }}</td>
        <td>{{ a.employee ? a.employee.name }}</td><td class="small">{{ a.location ? a.location.pathString }}</td>
        <td><form method="post" action="{{ path('bundle_items', {id: bundle.id}) }}" class="inline-form"><input type="hidden" name="remove" value="{{ a.id }}">
            <input type="hidden" name="_token" value="{{ csrf_token('bundle' ~ bundle.id) }}"><button class="btn small">Исключить</button></form></td></tr>
    {% else %}<tr><td colspan="6" class="muted">Нет компонентов</td></tr>{% endfor %}
</table></div>
<details class="panel" style="margin-top:12px"><summary>Переименовать</summary>
    <form method="post" action="{{ path('bundle_save') }}" class="actions" style="margin-top:8px"><input type="hidden" name="id" value="{{ bundle.id }}">
        <input type="text" name="name" value="{{ bundle.name }}"><input type="text" name="comment" value="{{ bundle.comment }}">
        <input type="hidden" name="_token" value="{{ csrf_token('bundle_save') }}"><button class="btn">Сохранить</button></form></details>
{% endblock %}
