{% extends 'base.html.twig' %}
{% block title %}Комплекты{% endblock %}
{% block body %}
<h1>Комплекты</h1>
<p class="muted small">Комплект объединяет самостоятельные активы (ноутбук, блок питания, сумка, док-станция, монитор). Каждый компонент сохраняет собственный номер, штрихкод, статус и историю.</p>
<form method="post" action="{{ path('bundle_save') }}" class="panel actions">
    <input type="text" name="name" placeholder="Название комплекта" required style="max-width:320px">
    <input type="text" name="comment" placeholder="Комментарий" style="max-width:320px">
    <input type="hidden" name="_token" value="{{ csrf_token('bundle_save') }}"><button class="btn primary">Создать</button>
</form>
<div class="table-wrap"><table>
    <thead><tr><th>Комплект</th><th>Компоненты</th><th>Сотрудник</th><th>Создан</th></tr></thead>
    {% for b in bundles %}<tr><td><a href="{{ path('bundle_show', {id: b.id}) }}">{{ b.name }}</a></td>
        <td class="small">{% for a in b.assets %}<span class="mono">{{ a.inventoryNumber }}</span>{{ not loop.last ? ', ' }}{% else %}—{% endfor %}</td>
        <td class="small">{{ (b.assets|first) and (b.assets|first).employee ? (b.assets|first).employee.name }}</td><td class="small">{{ b.createdAt|dt('d.m.Y') }}</td></tr>
    {% else %}<tr><td colspan="4" class="muted">Комплектов нет</td></tr>{% endfor %}
</table></div>
{% endblock %}
