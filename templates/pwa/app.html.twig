<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#1f4e79">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Инвентаризация">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="apple-touch-icon" href="/icons/icon-192.png">
    <title>Инвентаризация (мобильная)</title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="/css/pwa.css">
</head>
<body class="pwa">
<header class="pwa-bar">
    <b>Инвентаризация</b>
    <span id="net" class="badge gray">…</span>
    <span id="queue" class="badge gray" title="Ожидают синхронизации">0</span>
</header>

<section id="v-campaigns" class="pwa-view">
    <h2>Кампании</h2>
    <div id="campaign-list" class="muted">Загрузка…</div>
    <h2>Загруженные для offline</h2>
    <div id="offline-list"></div>
    <p class="small muted">Пользователь: {{ app.user.fullName ?: app.user.username }} · <a href="/">полная версия</a></p>
</section>

<section id="v-scan" class="pwa-view" hidden>
    <div class="actions" style="justify-content:space-between">
        <button class="btn small" id="back">← Кампании</button>
        <span id="c-title" class="small"></span>
    </div>
    <div class="field"><label>Помещение</label><select id="room"></select></div>
    <div class="cam-wrap" id="cam-wrap" hidden><video id="video" playsinline muted></video><div class="cam-frame"></div></div>
    <div class="actions" style="margin:8px 0">
        <button class="btn primary" id="cam-btn">📷 Камера</button>
        <input type="text" id="manual" class="mono" placeholder="Инв. номер вручную / USB" autocomplete="off" style="flex:1">
    </div>
    <div class="actions small">
        <label><input type="radio" name="flag" value="" checked> норм.</label>
        <label><input type="radio" name="flag" value="damaged"> поврежден</label>
        <label><input type="radio" name="flag" value="label_damaged"> этикетка</label>
        <label><input type="radio" name="flag" value="clarify"> уточнить</label>
    </div>
    <input type="text" id="comment" placeholder="Комментарий к следующему скану (необязательно)" style="margin-top:6px">
    <div id="last"></div>
    <div class="actions" style="justify-content:space-between;margin-top:10px">
        <b>Сканы на устройстве</b>
        <button class="btn small" id="sync-btn">Синхронизировать</button>
    </div>
    <div id="ops"></div>
</section>

<script src="/js/app.js"></script>
<script src="/js/pwa.js"></script>
</body>
</html>
