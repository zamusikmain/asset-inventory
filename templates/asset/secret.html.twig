{% extends 'base.html.twig' %}
{% block title %}Recovery key{% endblock %}
{% block body %}
<h1>Recovery key: {{ asset.inventoryNumber }}</h1>
<div class="panel" style="max-width:640px">
    {% if value %}
        <div class="secret" id="s" data-v="{{ value }}">{{ '•'|repeat(value|length) }}</div>
        <div class="actions" style="margin-top:10px">
            <button class="btn" onclick="const e=document.getElementById('s');e.textContent=e.dataset.v;this.remove()">Показать (30 сек.)</button>
            <a class="btn" href="{{ path('asset_show', {id: asset.id}) }}">Закрыть</a>
        </div>
        <p class="help">Просмотр зафиксирован в журнале аудита. Не копируйте значение в незащищенные каналы.</p>
    {% else %}<p class="muted">Значение не сохранено.</p>{% endif %}
</div>
<script>setTimeout(() => location.replace('{{ path('asset_show', {id: asset.id}) }}'), 30000);</script>
{% endblock %}
