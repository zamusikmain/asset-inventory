{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as m %}
{% block title %}Сотрудники{% endblock %}
{% block body %}
<div class="actions" style="justify-content:space-between"><h1>Сотрудники</h1><a class="btn primary" href="{{ path('employee_new') }}">+ Добавить</a></div>
<form class="filters panel">
    <div class="field" style="flex:1"><label>Поиск</label><input type="search" name="q" value="{{ q }}" placeholder="ФИО, email, UPN"></div>
    <div class="field"><label>Статус</label><select name="status"><option value="">Все</option>
        {% for l, v in {'Работает': 'active', 'Уволен': 'dismissed', 'Декрет/отпуск': 'leave'} %}<option value="{{ v }}" {{ status == v ? 'selected' }}>{{ l }}</option>{% endfor %}</select></div>
    <button class="btn primary">Найти</button>
</form>
<div class="table-wrap"><table>
    <thead><tr><th>ФИО</th><th>Должность</th><th>Подразделение</th><th>Офис</th><th>Email</th><th>Источник</th><th class="right">Оборудование</th></tr></thead>
    {% for e in pager %}
        <tr><td><a href="{{ path('employee_show', {id: e.id}) }}">{{ e.name }}</a>{% if e.fullNameRu and e.displayName != e.fullNameRu %}<div class="small muted">{{ e.displayName }}</div>{% endif %}</td>
            <td class="small">{{ e.position }}</td><td class="small">{{ e.department }}</td><td class="small">{{ e.office ? e.office.name }}</td>
            <td class="small">{{ e.email }}</td><td class="small muted">{{ e.source }}</td>
            <td class="right">{{ counts[e.id.toRfc4122] ?? 0 }}</td></tr>
    {% else %}<tr><td colspan="7" class="muted">Нет сотрудников</td></tr>{% endfor %}
</table></div>
{{ m.pager(pager, 'employee_index', {q: q, status: status}) }}
{% endblock %}
