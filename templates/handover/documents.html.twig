{% extends 'base.html.twig' %}
{% block title %}Акты{% endblock %}
{% block body %}
<h1>Акты и подписи</h1>
<form class="filters panel">
    <div class="field"><label>Тип</label><select name="type"><option value="">Все</option>
        {% for v, l in {'issue': 'Выдача', 'return': 'Возврат', 'inventory': 'Инвентаризация'} %}<option value="{{ v }}" {{ type == v ? 'selected' }}>{{ l }}</option>{% endfor %}</select></div>
    <div class="field"><label>Статус подписи</label><select name="status"><option value="">Все</option>
        {% for v, l in {'awaiting_signature': 'Ожидает подписи', 'signed': 'Подписан', 'rejected': 'Отклонен', 'expired': 'Срок истек'} %}<option value="{{ v }}" {{ status == v ? 'selected' }}>{{ l }}</option>{% endfor %}</select></div>
    <button class="btn primary">Показать</button>
</form>
<div class="table-wrap"><table>
    <thead><tr><th>Номер</th><th>Тип</th><th>Дата</th><th>Сотрудник / кампания</th><th>Позиций</th><th>Статус</th><th>IT</th></tr></thead>
    {% for d in docs %}
        <tr><td>{% if d.type == 'inventory' %}<a href="{{ path('inventory_act_pdf', {id: d.id}) }}" target="_blank">{{ d.number }}</a>{% else %}<a href="{{ path('handover_document', {id: d.id}) }}">{{ d.number }}</a>{% endif %}</td>
            <td>{{ d.typeLabel }}</td><td class="small nowrap">{{ d.createdAt|dt }}</td>
            <td>{{ d.employee ? d.employee.name : (d.campaign ? d.campaign.number : '') }}</td>
            <td>{{ d.items|length }}</td>
            <td>{{ badge(d.statusLabel, d.status == 'signed' ? 'green' : (d.status == 'awaiting_signature' ? 'amber' : (d.status == 'not_required' ? 'gray' : 'red'))) }}</td>
            <td class="small">{{ d.itUser }}</td></tr>
    {% else %}<tr><td colspan="7" class="muted">Нет документов</td></tr>{% endfor %}
</table></div>
{% endblock %}
