{% extends 'base.html.twig' %}
{% block title %}{{ is_new ? 'Новая лицензия' : license }}{% endblock %}
{% block body %}
<h1>{{ is_new ? 'Новая лицензия' : 'Лицензия: ' ~ license }}</h1>
{{ form_start(form, {attr: {class: 'panel'}}) }}
<div class="form-grid">{{ form_widget(form) }}</div>
<p class="help">Секретный ключ лицензии задается отдельно на карточке: он шифруется, маскируется и не попадает в экспорты.</p>
<div class="actions"><button class="btn primary">Сохранить</button><a class="btn" href="{{ is_new ? path('license_index') : path('license_show', {id: license.id}) }}">Отмена</a></div>
{{ form_end(form) }}
{% endblock %}
