{% extends 'base.html.twig' %}
{% block title %}Ключ лицензии{% endblock %}
{% block body %}
<h1>Ключ лицензии: {{ license }}</h1>
<div class="panel" style="max-width:640px">
    {% if value %}
        <div class="secret" id="s" data-v="{{ value }}">{{ '•'|repeat(value|length) }}</div>
        <div class="actions" style="margin-top:10px"><button class="btn" onclick="const e=document.getElementById('s');e.textContent=e.dataset.v;this.remove()">Показать (30 сек.)</button>
            <a class="btn" href="{{ path('license_show', {id: license.id}) }}">Закрыть</a></div>
        <p class="help">Просмотр зафиксирован в журнале аудита.</p>
    {% else %}<p class="muted">Значение не сохранено.</p>{% endif %}
</div>
<script>setTimeout(() => location.replace('{{ path('license_show', {id: license.id}) }}'), 30000);</script>
{% endblock %}
