# Значения по умолчанию для DEV. Для TEST/PROD переопределяются в .env.local / реальных
# переменных окружения. Секреты PROD в репозиторий не коммитятся.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=dev-only-change-me-in-env-local-0123456789
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

DEFAULT_URI=http://localhost:8080

###> doctrine/doctrine-bundle ###
POSTGRES_DB=assets
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL="postgresql://app:app@db:5432/assets?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# DEV: mailpit из compose. PROD: внутренний SMTP, например smtp://relay.corp.local:25
MAILER_DSN=smtp://mailpit:1025
MAIL_FROM="IT-учет <it-assets@company.local>"
###< symfony/mailer ###

# --- Приложение ---
ORG_NAME="ТОО «Компания»"
IT_CONTACTS="IT-отдел: it@company.local, вн. 100"
# Хранилище документов вне public-каталога
STORAGE_DIR=/var/www/storage
UPLOAD_MAX_BYTES=20971520
# Ключ шифрования секретов хранится ВНЕ БД. Пусто/нет файла — хранение recovery/лицензионных ключей отключено.
SECRETS_KEY_FILE=/var/www/storage/keys/secrets.key
# Блокировка учетной записи после N неудачных входов на M минут
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Автоблокировка сессии при бездействии (секунды)
SESSION_IDLE_TIMEOUT=1800
# Интеграции (п. 17): отключены по умолчанию
INTEGRATION_1C_ENABLED=0
# ЭЦП: URL сервиса проверки подписи (NCANode), пусто — только базовая проверка
NCANODE_URL=
# Базовая проверка OpenSSL (без цепочки/отзыва) считается достаточной? 0 — нужна ручная проверка или NCANode
SIGNATURE_ACCEPT_BASIC=0
# Срок на подписание акта, дней
SIGN_DEADLINE_DAYS=5
# Email администратора для уведомлений о технических ошибках
ADMIN_ALERT_EMAIL=
